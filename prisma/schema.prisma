generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id                 String              @id @default(uuid())
  phoneNumber        String
  name               String?
  gender             Gender              @default(UNKNOWN)
  skillLevel         Float               @default(0)
  reliabilityScore   Float               @default(0)
  lastContactedAt    DateTime?
  dailyMessagesCount Int                 @default(0)
  active             Boolean             @default(true)
  groupIds           String[]            @default([])
  notes              String?
  clubId             String?
  invitations        Invitation[]
  MatchPlayer        MatchPlayer[]
  feedbacks          MatchFeedback[]
  pendingOnboardings PendingOnboarding[] @relation("InvitedBy")
  club               Club?               @relation(fields: [clubId], references: [id])

  @@unique([phoneNumber, clubId])
  @@index([clubId, active, skillLevel, dailyMessagesCount])
  @@index([clubId, active, lastContactedAt])
}

model Court {
  id      String  @id @default(uuid())
  clubId  String
  name    String
  active  Boolean @default(true)
  isCovered Boolean @default(false)
  notes     String? // Note (es. superficie, illuminazione)
  club    Club    @relation(fields: [clubId], references: [id])
  matches Match[]
  feedbacks MatchFeedback[]
  prices    CourtPrice[]
}

model Match {
  id                String        @id @default(uuid())
  type              MatchType     @default(MATCH)
  clubId            String?
  courtId           String?
  startTime         DateTime
  endTime           DateTime?
  skillLevel        Float
  isMixed           Boolean       @default(false)
  allowMixedLevels  Boolean       @default(false)
  playersNeeded     Int           @default(4)
  status            MatchStatus   @default(OPEN)
  preferredPlayerIds String[]     @default([])
  groupId           String?
  cancelledAt       DateTime?
  cancelledReason   String?
  recoveryWaveCount Int           @default(0)
  invitations       Invitation[]
  club              Club?         @relation(fields: [clubId], references: [id])
  court             Court?        @relation(fields: [courtId], references: [id])
  MatchPlayer       MatchPlayer[]
  feedbacks         MatchFeedback[]

  @@index([status, startTime])
  @@index([clubId, status])
  @@index([clubId, status, startTime])
  @@index([courtId])
}

model Invitation {
  id                String           @id @default(uuid())
  matchId           String
  playerId          String
  status            InvitationStatus @default(PENDING)
  sentAt            DateTime         @default(now())
  respondedAt       DateTime?
  minutesUntilMatch Int?
  isFriendInvite    Boolean          @default(false)
  invitedById       String?
  match             Match            @relation(fields: [matchId], references: [id])
  player            Player           @relation(fields: [playerId], references: [id])

  @@index([playerId, status])
  @@index([matchId, status])
  @@index([status, sentAt])
}

model MatchPlayer {
  id       String    @id @default(uuid())
  matchId  String
  playerId String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  noShow   Boolean   @default(false)
  match    Match     @relation(fields: [matchId], references: [id])
  player   Player    @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
}

model PendingOnboarding {
  id                String   @id @default(uuid())
  matchId           String
  phoneNumber       String
  name              String?
  skillLevel        Float?
  invitedByPlayerId String
  createdAt         DateTime @default(now())
  resolved          Boolean  @default(false)
  invitedBy         Player   @relation("InvitedBy", fields: [invitedByPlayerId], references: [id])
}

model Club {
  id                         String   @id @default(uuid())
  name                       String
  timezone                   String   @default("Europe/Rome")
  matchDuration              Int      @default(90)
  openTime                   String   @default("08:00")
  closeTime                  String   @default("23:30")
  aiTone                     String?
  adminPhone                 String?
  adminAlternativePhone      String?
  waveMultiplier             Int      @default(3)
  deadlineMinutesBeforeMatch Int      @default(60)
  allowMixedLevels           Boolean  @default(false)
  allowMixedGenderMatchmaking Boolean  @default(false)
  mixedLevelRange            Int      @default(1)
  matchUpperRange            Float    @default(1.0)
  matchLowerRange            Float    @default(1.0)
  skillTestDuration          Int      @default(60)
  skillTestCost              Float    @default(0.0)
  skillLevelCount            Int      @default(3)
  maxDailyMessages           Int      @default(2)
  city                       String?
  address                    String?
  dashboardUsername          String?  @unique
  dashboardPasswordHash      String?
  groupJids                  String[] @default([])
  courts                     Court[]
  matches                    Match[]
  players                    Player[]
}

model WhatsAppMessage {
  id        String   @id @default(uuid())
  chatId    String
  sender    String
  role      String
  content   String
  messageId String?
  timestamp DateTime @default(now())

  @@index([chatId])
  @@index([chatId, role])
  @@index([timestamp])
  @@index([messageId])
}

enum MatchStatus {
  OPEN
  LOCKED
  CANCELLED
  UNFILLED
  ARCHIVED
}

enum MatchType {
  MATCH
  LESSON
  UNAVAILABLE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  IGNORED
  EXPIRED
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

model MatchFeedback {
  id        String   @id @default(uuid())
  matchId   String
  playerId  String
  courtId   String
  content   String
  timestamp DateTime @default(now())

  match  Match  @relation(fields: [matchId], references: [id])
  player Player @relation(fields: [playerId], references: [id])
  court  Court  @relation(fields: [courtId], references: [id])

  @@index([matchId])
  @@index([playerId])
}

model CourtPrice {
  id        String    @id @default(uuid())
  courtId   String
  startTime String    // "08:00"
  endTime   String    // "09:00"
  price     Float
  startDate DateTime?
  endDate   DateTime?

  court     Court     @relation(fields: [courtId], references: [id])

  @@index([courtId])
}

// Stato conversazionale persistente (dual-write con Redis).
// Redis è il primary (velocità); questa tabella è il fallback in caso di restart/crash Redis.
model ConversationState {
  key       String   @id       // e.g. "state:booking:39340...@s.whatsapp.net"
  value     Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
