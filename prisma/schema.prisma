generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id                 String              @id @default(uuid())
  phoneNumber        String
  name               String?
  gender             Gender              @default(UNKNOWN)
  skillLevel         Int                 @default(3)
  reliabilityScore   Float               @default(0)
  lastContactedAt    DateTime?
  dailyMessagesCount Int                 @default(0)
  active             Boolean             @default(true)
  groupIds           String[]            @default([])
  clubId             String?
  invitations        Invitation[]
  MatchPlayer        MatchPlayer[]
  pendingOnboardings PendingOnboarding[] @relation("InvitedBy")
  club               Club?               @relation(fields: [clubId], references: [id])

  @@unique([phoneNumber, clubId])
  @@index([clubId, active, skillLevel, dailyMessagesCount])
  @@index([clubId, active, lastContactedAt])
}

model Court {
  id      String  @id @default(uuid())
  clubId  String
  name    String
  active  Boolean @default(true)
  club    Club    @relation(fields: [clubId], references: [id])
  matches Match[]
}

model Match {
  id                String        @id @default(uuid())
  clubId            String?
  courtId           String?
  startTime         DateTime
  endTime           DateTime?
  skillLevel        Int
  allowMixedLevels  Boolean       @default(false)
  playersNeeded     Int           @default(4)
  status            MatchStatus   @default(OPEN)
  groupId           String?
  cancelledAt       DateTime?
  cancelledReason   String?
  recoveryWaveCount Int           @default(0)
  invitations       Invitation[]
  club              Club?         @relation(fields: [clubId], references: [id])
  court             Court?        @relation(fields: [courtId], references: [id])
  MatchPlayer       MatchPlayer[]

  @@index([status, startTime])
  @@index([clubId, status])
  @@index([clubId, status, startTime])
  @@index([courtId])
}

model Invitation {
  id                String           @id @default(uuid())
  matchId           String
  playerId          String
  status            InvitationStatus @default(PENDING)
  sentAt            DateTime         @default(now())
  respondedAt       DateTime?
  minutesUntilMatch Int?
  isFriendInvite    Boolean          @default(false)
  invitedById       String?
  match             Match            @relation(fields: [matchId], references: [id])
  player            Player           @relation(fields: [playerId], references: [id])

  @@index([playerId, status])
  @@index([matchId, status])
  @@index([status, sentAt])
}

model MatchPlayer {
  id       String    @id @default(uuid())
  matchId  String
  playerId String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  noShow   Boolean   @default(false)
  match    Match     @relation(fields: [matchId], references: [id])
  player   Player    @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
}

model PendingOnboarding {
  id                String   @id @default(uuid())
  matchId           String
  phoneNumber       String
  name              String?
  skillLevel        Int?
  invitedByPlayerId String
  createdAt         DateTime @default(now())
  resolved          Boolean  @default(false)
  invitedBy         Player   @relation("InvitedBy", fields: [invitedByPlayerId], references: [id])
}

model Club {
  id                         String   @id @default(uuid())
  name                       String
  timezone                   String   @default("Europe/Rome")
  matchDuration              Int      @default(90)
  openTime                   String   @default("08:00")
  closeTime                  String   @default("23:30")
  aiTone                     String?
  adminPhone                 String?
  waveMultiplier             Int      @default(3)
  deadlineMinutesBeforeMatch Int      @default(60)
  allowMixedLevels           Boolean  @default(false)
  mixedLevelRange            Int      @default(1)
  skillLevelCount            Int      @default(3)
  dashboardUsername          String?  @unique
  dashboardPasswordHash      String?
  groupJids                  String[] @default([])
  courts                     Court[]
  matches                    Match[]
  players                    Player[]
}

model WhatsAppMessage {
  id        String   @id @default(uuid())
  chatId    String
  sender    String
  role      String
  content   String
  timestamp DateTime @default(now())

  @@index([chatId])
  @@index([chatId, role])
  @@index([timestamp])
}

enum MatchStatus {
  OPEN
  LOCKED
  CANCELLED
  UNFILLED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  IGNORED
  EXPIRED
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}
